# Copy to scanner.env. Keep this file private after filling it in.
# Use two different, long random passwords. Single-quote values containing $ or #.
SCANNER_DB_PASSWORD=
SCANNER_DB_ROOT_PASSWORD=

# For Unraid, use /mnt/user/appdata/eve-contract-scanner/data instead.
APPDATA_PATH=./appdata
WEB_BIND_IP=0.0.0.0
WEB_PORT=5003
SCAN_INTERVAL_SECONDS=600

# Empty = the script's existing region list; otherwise comma-separated exact names.
SCANNER_REGIONS=
MINIMUM_PROFIT_PERCENTAGE=25
GOOD_PROFIT_PERCENTAGE=40
MINIMUM_PROFIT_ABSOLUTE=50000000
GOOD_PROFIT_ABSOLUTE=1000000000

# Optional Discord notifications. Empty webhook = scan and save without notifying.
SCANNER_DISCORD_WEBHOOK_URL=
# Role: &1234567890 ; user: @1234567890 (without angle brackets).
SCANNER_DISCORD_TAG_ID=
SCANNER_DISCORD_SENDER_NAME=EVE Contract Scanner
SCANNER_DISCORD_ICON_URL=
